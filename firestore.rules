rules_version = '2';

// Matches docs/DATA_CONTRACT.md. `users` is live now (AuthRepositoryImpl reads/writes it on
// login/register); `news` and `reports` are here pre-emptively for when those features land.
service cloud.firestore {
  match /databases/{database}/documents {

    // Profile written by the app itself after Firebase Auth sign-in/sign-up.
    // Only the signed-in owner can read or write their own document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public read-only feed; only an admin/pipeline (via the Firebase console or
    // Admin SDK, which bypasses these rules) should ever write news.
    match /news/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    // A user can create and read only their own reports.
    match /reports/{reportId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update, delete: if false; // status/response updates are admin-only (Admin SDK)
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
